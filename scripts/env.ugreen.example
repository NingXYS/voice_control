# Example capture settings for UGREEN USB MIC-CM581 (card name: MICCM581).
#
# Usage:
#   source scripts/env.ugreen.example
#   python3 scripts/voice_capture_smoke.py --seconds 5
#   bash scripts/run_voice_wake.sh --check
#
# Discover the card index if it changed after replug:
#   python3 scripts/voice_capture_smoke.py --probe-only
#   arecord -l

export AUDIO_DEVICE="${AUDIO_DEVICE:-hw:3,0}"
export AUDIO_CAPTURE_SAMPLE_RATE="${AUDIO_CAPTURE_SAMPLE_RATE:-48000}"
export AUDIO_CAPTURE_CHANNELS="${AUDIO_CAPTURE_CHANNELS:-2}"

# Multi-channel downmix (UGREEN is 2ch). Do NOT default to mean (phase risk).
# Lab A/B: try channel_0 then channel_1, pick the clearer one, then lock it.
export AUDIO_CHANNEL_MODE="${AUDIO_CHANNEL_MODE:-channel_0}"
# export AUDIO_CHANNEL_MODE=channel_1
# export AUDIO_CHANNEL_MODE=best_channel
# export AUDIO_CHANNEL_MODE=mean          # legacy only
# export AUDIO_CHANNEL_BEST_HOLD=5

# Dialogue frontend (VAD/ASR). KWS stays on raw mono by default.
# export VOICE_AUDIO_FRONTEND=passthrough   # default — safest for wake A/B
# export VOICE_AUDIO_FRONTEND=ns            # may help ASR; keep KWS on raw
# export VOICE_KWS_USE_RAW=1                # default: KWS ignores dialogue NS
# export VOICE_AUDIO_NS_STRENGTH=1.0
# export VOICE_AUDIO_NS_MIN_GAIN=0.08

# P1.2 KWS offline eval (after collecting datasets/wake WAVs):
# python3 scripts/eval_kws.py --init-dataset datasets/wake
# python3 scripts/eval_kws.py --dataset-root datasets/wake --frontends passthrough,ns

# P1.3 command VAD (default segment reduces swallowed first syllables)
# export VOICE_COMMAND_VAD_GATE=segment   # segment | frame | off
# export SPEECH_MIN_RMS=0.003
# export SPEECH_MIN_SNR_DB=2.0
# export VAD_PRE_ROLL_SEC=0.18

# Two-stage wake: high-threshold KWS direct + low-threshold KWS → ASR confirm.
# export WAKE_TWO_STAGE=1                 # default on for kws mode
# export KWS_HIGH_THRESHOLD=0.35          # harder → direct accept
# export KWS_LOW_THRESHOLD=0.15           # easier → needs ASR verify
# export WAKE_VERIFY_WINDOW_SEC=2.0
# export WAKE_MATCH_THRESHOLD=0.82        # ASR fuzzy match for verify
# export WAKE_TWO_STAGE=0                 # classic single KWS only

# Continuous dialogue after wake (lab-friendly defaults).
# After "小西小西", keep listening without re-wake until idle timeout.
# export VOICE_SESSION_TIMEOUT_SEC=60    # 1 minute idle window (default)
# export VOICE_SESSION_TIMEOUT_SEC=90    # 1.5 minutes
# export VOICE_SESSION_TIMEOUT_SEC=0     # classic: one wake → one reply → re-wake
# export VOICE_SESSION_END_PHRASES='退出,再见,结束对话,不用了'

# Command accuracy / TTS latency knobs
# export VOICE_WAKE_ACK_TEXT='我在'               # wake ack TTS; empty = beep only
# export VOICE_ACTION_ACK_TEXT='好的，正在执行'   # shorter = faster TTS
# export TTS_NUM_THREADS=4
# export TTS_SPEED=1.05
# export TTS_PLAYBACK_NATIVE=1                   # skip host resample (default on)
# export VOICE_TTS_TIMING=1                      # print gen_ms / play_ms
# Playback (MUST be a real device from `aplay -l`, never plughw:X,0):
#   unset APLAY_DEVICE            # use default (usually works via Pulse)
#   export APLAY_DEVICE=default
#   export APLAY_DEVICE=plughw:2,0   # e.g. ALC256 Analog on this machine


# If arecord says "device busy": GNOME Settings / PulseAudio is holding the mic.
# Release then capture:
#   python3 scripts/voice_capture_smoke.py --free-device --seconds 5
# or:
#   pasuspender -- env AUDIO_DEVICE=hw:3,0 AUDIO_CAPTURE_SAMPLE_RATE=48000 \
#     AUDIO_CAPTURE_CHANNELS=2 python3 scripts/voice_capture_smoke.py --seconds 5
# Manual:
#   pactl set-card-profile alsa_card.usb-JinAudio_UGREEN_USB_MIC-CM581_202508010032-00 off

# Optional level / debug helpers
# amixer -c 3 sset Mic 70%
# export VOICE_DEBUG_AUDIO=1
# export VOICE_DEBUG_AUDIO_DIR=./debug_audio_ugreen
