<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voice_control</name>
  <version>0.1.0</version>
  <description>Voice control for dual arm robot using MoveIt</description>
  <maintainer email="user@example.com">user</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tianlian</depend>

  <build_depend>nlohmann-json3-dev</build_depend>
  <exec_depend>nlohmann-json3-dev</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
