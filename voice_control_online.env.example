# VoiceOnline 环境模板 — 复制为 voice_control_online.env 后填写真实值
#   cp voice_control_online.env.example voice_control_online.env
#   chmod 600 voice_control_online.env
#   set -a && source ./voice_control_online.env && set +a
#
# 勿将含真实 DIFY_API_KEY 的文件提交到 Git 或拷贝到公开介质后不改 Key。

set -a

# 仓库根 = 本文件所在目录（勿写死其他机器的绝对路径）
VOICE_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------- Dify（必填才能在线验收）----------
# 同机 Dify 可用 127.0.0.1；远程服务必须使用 HTTPS。不要带 /v1
DIFY_BASE_URL=http://127.0.0.1:80
DIFY_API_KEY=app-REPLACE_ME
DIFY_INPUT_KEY=text
DIFY_OUTPUT_KEY=result
DIFY_TIMEOUT_SEC=60
DIFY_API_MODE=workflow

# ---------- 联网天气 / 搜索 ----------
# 本地天气前置链路使用 Open-Meteo，不需要 API Key。未说城市时使用默认城市。
# Dify 画布中的默认地区需另外修改工作流环境变量 DEFAULT_WEATHER_CITY。
# 通用“搜索一下……”交给 Dify 模型原生联网；请在 Dify 模型节点开启“联网搜索”。
VOICE_ENABLE_ONLINE_SERVICES=1
VOICE_DEFAULT_CITY=上海

# Web dashboard: keep the app on loopback and expose it only through HTTPS nginx.
VOICE_UI_HOST=127.0.0.1
VOICE_UI_PORT=8765
# Required for LAN HTTPS deployment, for example https://voice-robot.example.lan
VOICE_UI_PUBLIC_ORIGIN=
# Set a long random value; when empty, run_voice_ui.sh prints a per-run temporary token.
VOICE_UI_TOKEN=
VOICE_UI_SESSION_TTL_SEC=28800

# Network/logging hardening.
DIFY_CONNECT_TIMEOUT_SEC=5
DIFY_STREAM_TOTAL_TIMEOUT_SEC=45
VOICE_ALLOW_INSECURE_DIFY=0
VOICE_LOG_TRANSCRIPTS=0
VOICE_DEBUG_AUDIO_RETENTION_FILES=20
# Preferred shell-free camera command. VOICE_CAMERA_RUN remains temporarily compatible.
VOICE_CAMERA_COMMAND_JSON='["ros2","run","gemini_detector","gemini_detector"]'
VOICE_ONLINE_TIMEOUT_SEC=8

# ---------- 音频设备 ----------
# 默认设备；UGREEN 见 scripts/env.ugreen.example（常需 48kHz/2ch）
AUDIO_DEVICE=default
APLAY_DEVICE=default
AUDIO_CAPTURE_SAMPLE_RATE=16000
AUDIO_CAPTURE_CHANNELS=1
# UGREEN 示例：
# AUDIO_DEVICE=hw:CARD=MICCM581,DEV=0
# AUDIO_CAPTURE_SAMPLE_RATE=48000
# AUDIO_CAPTURE_CHANNELS=2
# AUDIO_CHANNEL_MODE=channel_0

# ---------- 唤醒 / 安全 ----------
WAKE_DETECTOR_MODE=kws
WAKE_WORD=小西小西
VOICE_ENABLE_ROBOT_COMMAND=0

# ---------- 单臂按摩（独立安全开关，默认关闭）----------
VOICE_ENABLE_MASSAGE=0
# 无机械臂调试时设为 1；实机运行前必须恢复为 0
VOICE_MASSAGE_DRY_RUN=0
VOICE_MASSAGE_SDK_ROOT=/home/li/xCoreSDK_cpp-v0.7.1
VOICE_MASSAGE_BUILD_DIR=/home/li/xCoreSDK_cpp-v0.7.1/build
VOICE_MASSAGE_DATA_DIR="${VOICE_REPO_ROOT}/massage_data"
VOICE_MASSAGE_TEACHING_BIN=/home/li/xCoreSDK_cpp-v0.7.1/build/bin/drag_cartesian_pose_reader
VOICE_MASSAGE_U_CHUI_BIN=/home/li/xCoreSDK_cpp-v0.7.1/build/bin/u_chui
VOICE_MASSAGE_BUILD_TARGET=u_chui
VOICE_MASSAGE_BUILD_TIMEOUT_SEC=180

# ---------- 本地模型（相对仓库根）----------
PARAFORMER_MODEL_DIR="${VOICE_REPO_ROOT}/models/sherpa-onnx-paraformer-zh-2023-09-14"
WAKE_MODEL_DIR="${VOICE_REPO_ROOT}/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20"
VAD_MODEL_PATH="${VOICE_REPO_ROOT}/models/vad/silero_vad.onnx"

# ---------- 音频前端 / KWS（实验室可用默认）----------
VOICE_AUDIO_FRONTEND=passthrough
VOICE_KWS_USE_RAW=1
WAKE_TWO_STAGE=1
KWS_HIGH_THRESHOLD=0.35
KWS_LOW_THRESHOLD=0.15
KWS_KEYWORDS_THRESHOLD=0.35
KWS_KEYWORDS_SCORE=1.5
WAKE_VERIFY_WINDOW_SEC=2.0
WAKE_MATCH_THRESHOLD=0.82
# 0=单次唤醒；大于 0=在指定秒数内连续收音
VOICE_SESSION_TIMEOUT_SEC=0
VOICE_STREAM_REPLY=1
VOICE_SENTENCE_TTS=1

VOICE_COMMAND_VAD_GATE=segment
SPEECH_MIN_RMS=0.004
SPEECH_MIN_SNR_DB=4.5
VAD_SILENCE_DURATION_SEC=0.40
VAD_MIN_SPEECH_DURATION_SEC=0.20
VAD_MAX_SPEECH_DURATION_SEC=6.0
COMMAND_MAX_DURATION_SEC=8.0
FOLLOWUP_COMMAND_MAX_DURATION_SEC=6.0
FOLLOWUP_VAD_SILENCE_SEC=0.35
VAD_PRE_ROLL_SEC=0
VAD_THRESHOLD=0.50
WAKE_COOLDOWN_SEC=0.6
# 唤醒应答“我在”播放后排空扬声器尾音，避免 VAD 把回声录成 6 秒长指令。
PROMPT_GUARD_DURATION_SEC=0.25
POST_TTS_GUARD_DURATION_SEC=0.45
VOICE_ACTION_ACK_TEXT=好的，正在执行

# ---------- TTS：默认 Matcha（推荐）----------
TTS_ENGINE=matcha
PIPER_MODEL_DIR="${VOICE_REPO_ROOT}/models/tts/matcha-icefall-zh-baker"
TTS_MODEL_DIR="${PIPER_MODEL_DIR}"
TTS_MODEL_FILE=model-steps-3.onnx
TTS_VOCODER="${VOICE_REPO_ROOT}/models/tts/matcha-icefall-zh-baker/vocos-22khz-univ.onnx"
TTS_SPEAKER_ID=0
TTS_NUM_THREADS=8
TTS_PLAYBACK_NATIVE=1
TTS_PHRASE_CACHE_SIZE=128
TTS_PRECACHE_MAX=64
TTS_STREAM_PLAYBACK=1
VOICE_TTS_TIMING=1
TTS_WARMUP_PHRASES='我在|好的，正在执行|小西收到'
TTS_PHRASE_CACHE_DIR="${VOICE_REPO_ROOT}/models/tts/phrase_cache"

# Kokoro 备选（取消注释并注释 Matcha 段）：
# TTS_ENGINE=kokoro
# PIPER_MODEL_DIR="${VOICE_REPO_ROOT}/models/tts/kokoro-multi-lang-v1_0"
# TTS_MODEL_DIR="${PIPER_MODEL_DIR}"
# TTS_MODEL_FILE=model.onnx
# TTS_SPEAKER_ID=47
# unset TTS_VOCODER

set +a
