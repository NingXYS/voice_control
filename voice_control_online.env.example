# VoiceOnline 环境模板：复制为 voice_control_online.env 后填写真实值。
#   cp voice_control_online.env.example voice_control_online.env
#   chmod 600 voice_control_online.env
#   set -a && source ./voice_control_online.env && set +a
#
# 请勿提交包含真实 DIFY_API_KEY 或 VOICE_UI_TOKEN 的私有环境文件。

set -a

# 仓库根目录；模型、缓存和运行数据的相对路径均以此为基准。
VOICE_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ---------- Dify ----------
# Dify 服务根地址；不要带 /v1。同机可使用 127.0.0.1，远程服务建议使用 HTTPS。
DIFY_BASE_URL=http://127.0.0.1:80
# Dify 应用 API Key；私有文件中替换为真实值，切勿提交。
DIFY_API_KEY=app-REPLACE_ME
# 发送给 Dify 工作流的输入变量名，必须与工作流开始节点一致。
DIFY_INPUT_KEY=text
# 从 Dify 工作流响应中读取的输出变量名，必须与结束节点一致。
DIFY_OUTPUT_KEY=result
# 单次非流式 Dify 请求的最长等待时间，单位为秒。
DIFY_TIMEOUT_SEC=60
# 建立到 Dify 服务连接的最长等待时间，单位为秒。
DIFY_CONNECT_TIMEOUT_SEC=5
# 流式 Dify 请求从开始到结束的总超时时间，单位为秒。
DIFY_STREAM_TOTAL_TIMEOUT_SEC=45
# Dify 应用类型；workflow 表示工作流应用。
DIFY_API_MODE=workflow
# 是否允许远程 Dify 使用不安全的 HTTP：0=禁止，1=允许。
VOICE_ALLOW_INSECURE_DIFY=0

# ---------- 联网天气 / 搜索 ----------
# 是否启用联网服务：1=启用，0=禁用。
VOICE_ENABLE_ONLINE_SERVICES=1
# 用户未说城市时天气查询使用的默认城市。
VOICE_DEFAULT_CITY=上海
# 本地天气使用 Open-Meteo，无需 API Key；Dify 工作流的默认地区需另改 DEFAULT_WEATHER_CITY。
# 通用“搜索一下……”由 Dify 模型处理，请在相应模型节点开启联网搜索。

# ---------- Web Dashboard ----------
# Dashboard 监听地址；127.0.0.1 表示仅本机可直接访问。
VOICE_UI_HOST=127.0.0.1
# Dashboard HTTP 监听端口。
VOICE_UI_PORT=8765
# 经 nginx 暴露时的唯一 HTTPS 来源，例如 https://voice-robot.example.lan。
VOICE_UI_PUBLIC_ORIGIN=
# Dashboard 登录令牌；留空时 run_voice_ui.sh 会生成本次运行的临时令牌。
VOICE_UI_TOKEN=
# Dashboard 登录会话有效期，单位为秒。
VOICE_UI_SESSION_TTL_SEC=28800

# ---------- 日志 / 外部命令 ----------
# 是否在日志中保留识别文本：0=不保留，1=保留；生产环境建议为 0。
VOICE_LOG_TRANSCRIPTS=0
# 调试时最多保留的音频文件数量；超过后清理最旧文件。
VOICE_DEBUG_AUDIO_RETENTION_FILES=20
# 相机动作命令的 JSON 参数数组，避免经 shell 拼接执行。
VOICE_CAMERA_COMMAND_JSON='["ros2","run","gemini_detector","gemini_detector"]'
# 天气、搜索等在线能力的请求超时时间，单位为秒。
VOICE_ONLINE_TIMEOUT_SEC=8

# ---------- 音频设备 ----------
# 录音设备名；default 使用系统默认输入，pulse 使用 PulseAudio/PipeWire 输入。
AUDIO_DEVICE=default
# TTS 播放设备名；default 使用系统默认输出。
APLAY_DEVICE=default
# 采集设备的原始采样率；必须与硬件实际输出一致。
AUDIO_CAPTURE_SAMPLE_RATE=16000
# 采集设备的原始声道数；单麦克风通常为 1。
AUDIO_CAPTURE_CHANNELS=1
# 多声道输入时选择或混合声道；示例值 channel_0 表示取第 1 声道。
# AUDIO_CHANNEL_MODE=channel_0
# UGREEN 示例（通常为 48 kHz / 双声道）：
# AUDIO_DEVICE=hw:CARD=MICCM581,DEV=0
# AUDIO_CAPTURE_SAMPLE_RATE=48000
# AUDIO_CAPTURE_CHANNELS=2

# ---------- 唤醒 / 安全 ----------
# 唤醒检测方式；kws 使用本地关键词模型。
WAKE_DETECTOR_MODE=kws
# 要监听的中文唤醒词，需与关键词模型或关键词配置匹配。
WAKE_WORD=小西小西
# 是否允许执行机器人动作命令：0=禁止，1=允许。
VOICE_ENABLE_ROBOT_COMMAND=0

# ---------- 单臂按摩 ----------
# 按摩功能独立总开关：0=关闭，1=启用。
VOICE_ENABLE_MASSAGE=0
# 按摩动作试运行：1=不驱动真机，0=连接并驱动机械臂。
VOICE_MASSAGE_DRY_RUN=0
# 机械臂 SDK 源码根目录。
VOICE_MASSAGE_SDK_ROOT=/home/li/xCoreSDK_cpp-v0.7.1
# 机械臂 SDK 构建产物目录。
VOICE_MASSAGE_BUILD_DIR=/home/li/xCoreSDK_cpp-v0.7.1/build
# 按摩示教点位和运行数据目录。
VOICE_MASSAGE_DATA_DIR="${VOICE_REPO_ROOT}/massage_data"
# 读取拖动示教笛卡尔位姿的可执行文件路径。
VOICE_MASSAGE_TEACHING_BIN=/home/li/xCoreSDK_cpp-v0.7.1/build/bin/drag_cartesian_pose_reader
# 执行按摩动作的可执行文件路径。
VOICE_MASSAGE_U_CHUI_BIN=/home/li/xCoreSDK_cpp-v0.7.1/build/bin/u_chui
# 需要构建的按摩程序 CMake target 名称。
VOICE_MASSAGE_BUILD_TARGET=u_chui
# 按摩程序构建的最长等待时间，单位为秒。
VOICE_MASSAGE_BUILD_TIMEOUT_SEC=180
# 按摩背景音乐目录；确认开始后从中随机选一首循环播放，按摩结束自动停止。
# 用户可自行放入 .mp3/.wav/.flac/.ogg/.m4a 文件。
VOICE_MASSAGE_MUSIC_DIR="${VOICE_REPO_ROOT}/massage_music"
# 1=启用按摩背景音乐，0=关闭。
VOICE_MASSAGE_MUSIC_ENABLED=1
# 背景音乐音量，0.0–1.0。
VOICE_MASSAGE_MUSIC_VOLUME=0.6

# ---------- 本地模型 / 声纹数据 ----------
# 中文 Paraformer ASR 模型目录。
PARAFORMER_MODEL_DIR="${VOICE_REPO_ROOT}/models/sherpa-onnx-paraformer-zh-2023-09-14"
# 中英文关键词唤醒 KWS 模型目录。
WAKE_MODEL_DIR="${VOICE_REPO_ROOT}/models/sherpa-onnx-kws-zipformer-zh-en-3M-2025-12-20"
# Silero VAD ONNX 模型文件路径。
VAD_MODEL_PATH="${VOICE_REPO_ROOT}/models/vad/silero_vad.onnx"
# 3D-Speaker/CAMPPlus 声纹嵌入模型文件路径。
VOICE_SPEAKER_MODEL_PATH="${VOICE_REPO_ROOT}/models/speaker/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx"
# sherpa-onnx 官方 ERes2Net-large 候选模型；用于与 CAM++ 做同录音对比。
VOICE_SPEAKER_ERES2NET_LARGE_MODEL_PATH="${VOICE_REPO_ROOT}/models/speaker/3dspeaker_speech_eres2net_large_sv_zh-cn_3dspeaker_16k.onnx"
# ModelScope ERes2NetV2 导出后的 ONNX 候选模型路径。
VOICE_SPEAKER_ERES2NETV2_MODEL_PATH="${VOICE_REPO_ROOT}/models/speaker/3dspeaker_speech_eres2netv2_sv_zh-cn_16k-common.onnx"
# ERes2NetV2 推理后端；当前导出文件已写入 3D-Speaker 元数据，可直接由 sherpa 加载。
VOICE_SPEAKER_ERES2NETV2_BACKEND=sherpa
# 声纹私有目录；v1 模板/分数与 v2 长期保留的本机 FLAC 都存放在这里。
VOICE_SPEAKER_PROFILE_DIR="${VOICE_REPO_ROOT}/runtime_data/speaker_profiles"

# ---------- 音频前端 / KWS ----------
# 音频前端模式；passthrough 表示不额外做降噪或回声消除。
VOICE_AUDIO_FRONTEND=passthrough
# KWS 是否使用前端处理前的原始音频：1=使用原始音频，0=使用处理后音频。
VOICE_KWS_USE_RAW=1
# 是否启用两阶段唤醒确认：1=启用，0=只使用单阶段检测。
WAKE_TWO_STAGE=1
# 第一阶段 KWS 的高置信度直接通过阈值。
KWS_HIGH_THRESHOLD=0.35
# 第一阶段 KWS 的低置信度候选阈值，候选会进入二阶段确认。
KWS_LOW_THRESHOLD=0.15
# sherpa-onnx 关键词触发概率阈值。
KWS_KEYWORDS_THRESHOLD=0.35
# sherpa-onnx 关键词分数增强系数。
KWS_KEYWORDS_SCORE=1.5
# 二阶段唤醒确认所分析的音频窗口长度，单位为秒。
WAKE_VERIFY_WINDOW_SEC=2.0
# 二阶段唤醒文本匹配阈值，越高越严格。
WAKE_MATCH_THRESHOLD=0.82

# ---------- 连续会话 / 声纹校验 ----------
# 连续唤醒会话时长，单位为秒；0=每条指令后重新唤醒，大于 0=期间可连续说指令。
VOICE_SESSION_TIMEOUT_SEC=0
# 声纹校验模式：off=关闭，shadow=只记录不拦截，enforce=在 ASR 前强制拦截。
VOICE_SPEAKER_VERIFY_MODE=off
# 声纹余弦相似度通过阈值；越高越严格，应结合现场评估数据调整。
VOICE_SPEAKER_THRESHOLD=0.60
# 打分方式：max_template=与任一登记模板取最大相似度（短命令更稳）；centroid=历史均值质心。
VOICE_SPEAKER_SCORE_MODE=max_template
# 声纹判定最短有效语音时长（毫秒）；过短命令在 CAM++ 上分数会塌到 0.5 附近。
VOICE_SPEAKER_MIN_SPEECH_MS=1000
# 声纹判定最低 RMS；与登记侧能量门对齐。
VOICE_SPEAKER_MIN_RMS=0.002
# 连续会话内声纹信任：off=每轮严检（旁人在场请用这个）；after_first=首轮通过后跳过；relaxed=后续阈值放宽。
VOICE_SPEAKER_SESSION_TRUST=off
# relaxed 模式下相对部署阈值下调量（0–0.5）。
VOICE_SPEAKER_SESSION_RELAX=0.05
# 声纹模型推理线程数；机器人端通常从 1 开始测试。
VOICE_SPEAKER_NUM_THREADS=4
# Dify 回复是否采用流式接收：1=流式，0=等待完整回复。
VOICE_STREAM_REPLY=1
# 是否按完整句子分段送入 TTS：1=分句，0=整段处理。
VOICE_SENTENCE_TTS=1

# ---------- 指令 VAD ----------
# 指令收音门控方式；segment 表示由 VAD 切出完整语音段。
VOICE_COMMAND_VAD_GATE=segment
# 语音段最低均方根音量；低于此值视为过静或噪声。
SPEECH_MIN_RMS=0.004
# 语音相对背景噪声的最低信噪比，单位为 dB。
SPEECH_MIN_SNR_DB=4.5
# 首条指令检测到该时长静音后结束收音，单位为秒。
VAD_SILENCE_DURATION_SEC=0.40
# 语音段最短有效时长，单位为秒。
VAD_MIN_SPEECH_DURATION_SEC=0.20
# VAD 允许单个语音段持续的最长时间，单位为秒。
VAD_MAX_SPEECH_DURATION_SEC=6.0
# 首条指令从开始等待到强制结束的最长时间，单位为秒。
COMMAND_MAX_DURATION_SEC=8.0
# 连续会话中后续指令的最长等待/录制时间，单位为秒。
FOLLOWUP_COMMAND_MAX_DURATION_SEC=6.0
# 连续会话中检测到该时长静音后结束后续指令收音，单位为秒。
FOLLOWUP_VAD_SILENCE_SEC=0.35
# VAD 触发前额外保留的音频长度，单位为秒；可避免吞掉句首。
VAD_PRE_ROLL_SEC=0
# Silero VAD 判定语音的概率阈值。
VAD_THRESHOLD=0.50
# 一次唤醒完成后的关键词检测冷却时间，单位为秒。
WAKE_COOLDOWN_SEC=0.6
# 播放“我在”后忽略麦克风尾音的时间，避免把回声当指令，单位为秒。
PROMPT_GUARD_DURATION_SEC=0.25
# 每次 TTS 播放结束后忽略扬声器尾音的时间，单位为秒。
POST_TTS_GUARD_DURATION_SEC=0.45
# 执行动作前播报的固定确认语。
VOICE_ACTION_ACK_TEXT=好的，正在执行

# ---------- TTS：Matcha（推荐） ----------
# TTS 引擎名称；matcha 使用 Matcha 声学模型和 Vocos 声码器。
TTS_ENGINE=matcha
# TTS 模型主目录；保留 PIPER_MODEL_DIR 名称以兼容现有脚本。
PIPER_MODEL_DIR="${VOICE_REPO_ROOT}/models/tts/matcha-icefall-zh-baker"
# TTS 模型目录，通常与 PIPER_MODEL_DIR 相同。
TTS_MODEL_DIR="${PIPER_MODEL_DIR}"
# TTS 声学模型文件名，相对于 TTS_MODEL_DIR。
TTS_MODEL_FILE=model-steps-3.onnx
# Matcha 配套 Vocos 声码器 ONNX 文件路径。
TTS_VOCODER="${VOICE_REPO_ROOT}/models/tts/matcha-icefall-zh-baker/vocos-22khz-univ.onnx"
# 多说话人 TTS 模型使用的说话人编号。
TTS_SPEAKER_ID=0
# TTS ONNX 推理线程数。
TTS_NUM_THREADS=8
# 是否按模型原生采样率直接播放：1=是，0=走兼容转换。
TTS_PLAYBACK_NATIVE=1
# 内存中最多缓存的合成短语数量。
TTS_PHRASE_CACHE_SIZE=128
# 启动时最多预生成并载入的短语数量。
TTS_PRECACHE_MAX=64
# 是否边合成边播放 TTS：1=启用，0=完整合成后播放。
TTS_STREAM_PLAYBACK=1
# 是否记录 TTS 阶段耗时：1=记录，0=关闭。
VOICE_TTS_TIMING=1
# 启动预热短语，使用竖线分隔，可降低首次播报延迟。
TTS_WARMUP_PHRASES='我在|好的，正在执行|小西收到'
# TTS 短语磁盘缓存目录。
TTS_PHRASE_CACHE_DIR="${VOICE_REPO_ROOT}/models/tts/phrase_cache"

# ---------- Kokoro 备选 ----------
# 使用时取消以下参数注释，并注释上面的 Matcha 专属配置。
# TTS_ENGINE=kokoro                 # 切换到 Kokoro 引擎。
# PIPER_MODEL_DIR="${VOICE_REPO_ROOT}/models/tts/kokoro-multi-lang-v1_0"  # Kokoro 模型目录。
# TTS_MODEL_DIR="${PIPER_MODEL_DIR}" # Kokoro 模型目录别名。
# TTS_MODEL_FILE=model.onnx         # Kokoro 模型文件名。
# TTS_SPEAKER_ID=47                 # Kokoro 中文音色编号。
# unset TTS_VOCODER                 # Kokoro 不使用 Matcha 的 Vocos 配置。

set +a
