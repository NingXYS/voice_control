# Install under /etc/nginx/conf.d/ after replacing the example hostname and
# certificate paths. The VoiceOnline aiohttp process must remain on 127.0.0.1.
limit_req_zone $binary_remote_addr zone=voiceonline_auth:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=voiceonline_api:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=voiceonline_conn:10m;

map $http_upgrade $voiceonline_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name voice-robot.example.lan;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name voice-robot.example.lan;

    ssl_certificate /etc/ssl/voiceonline/fullchain.pem;
    ssl_certificate_key /etc/ssl/voiceonline/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:VOICEONLINE_TLS:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 16k;
    limit_conn voiceonline_conn 10;

    location = /api/auth {
        limit_req zone=voiceonline_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        limit_req zone=voiceonline_api burst=20 nodelay;
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /ws {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $voiceonline_connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 70s;
    }

    location / {
        proxy_pass http://127.0.0.1:8765;
        include proxy_params;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
}
